# 데이터 소스: mock(서버 없이 빈 상태로 실행) | http(백엔드 API)
VITE_API_MODE=mock
# http 모드에서 API 서버 주소. 비우면 같은 origin 상대 경로로 요청한다.
VITE_API_BASE=http://localhost:8000
# 기기 상태만 이 서버에서 받기 (GET /api/device/session/latest, 예: http://127.0.0.1:8000). 비우면 위 데이터 소스를 따른다
VITE_DEVICE_API_BASE=
# 지도 타일 URL 템플릿 (Leaflet 형식). 비우면 OpenStreetMap 표준 타일을 어둡게 필터링해 쓴다.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
# 타일을 CSS 필터로 어둡게 뒤집을지 (기본: 타일 URL을 비웠을 때만 true)
VITE_MAP_TILE_DARKEN=
# 타일을 서비스 워커로 7일 캐시 (기본 true). 끄려면 false
VITE_MAP_TILE_CACHE=
# VWorld 배경지도 인증키 (https://www.vworld.kr). 비우면 OpenStreetMap 사용
VITE_VWORLD_KEY=
# mock 모드에서 테스트용 예시 데이터(가짜 전주)를 쓸지. 앱 확인용으로는 켜지 말 것 (자동 테스트가 켠다)
VITE_MOCK_SAMPLE_DATA=false
# mock 모드의 초기 동기화 상태: done | syncing | failed (상태 화면 확인용)
VITE_MOCK_SYNC=done
