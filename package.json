{
  "name": "polewatch-front",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PoleWatch 사무실용 지도 대시보드 (전주 까치집·수목 위험 검수)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
